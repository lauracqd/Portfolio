<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Aninha Lacerda — Designer · Version A (dentelle haut)</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Mono:ital,wght@0,400;0,700;1,400&family=Syne:wght@400;700;800&family=Caveat:wght@600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --pink:   #FF3D8B;
      --hot:    #FF006E;
      --cream:  #FFF5E1;
      --black:  #111111;
      --lilac:  #C9B8FF;
      --yellow: #FFE24B;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--cream);
      color: var(--black);
      font-family: 'Space Mono', monospace;
      overflow-x: hidden;
      cursor: none;
    }

    #cur {
      width: 30px; height: 30px;
      position: fixed; top: 0; left: 0;
      pointer-events: none; z-index: 9999;
      transform: translate(-50%,-50%);
      transition: width .2s, height .2s;
      animation: cur-spin 5s linear infinite;
    }
    #cur.big { width: 54px; height: 54px; }
    @keyframes cur-spin {
      from { transform: translate(-50%,-50%) rotate(0deg); }
      to   { transform: translate(-50%,-50%) rotate(360deg); }
    }

    body::after {
      content: ''; position: fixed; inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='1'/%3E%3C/svg%3E");
      opacity: 0.03; pointer-events: none; z-index: 9998;
    }

    @keyframes tick { to { transform: translateX(-50%); } }

    /* NAV */
    nav {
      display: flex; justify-content: space-between; align-items: center;
      padding: 1.1rem 2.5rem;
      border-bottom: 3px solid var(--black);
      background: var(--cream);
      position: sticky; top: 0; z-index: 99;
    }
    .logo { font-family: 'Bebas Neue', sans-serif; font-size: 2rem; letter-spacing: .06em; text-decoration: none; color: var(--black); cursor: none; }
    .logo em { color: var(--pink); font-style: normal; }
    .nav-links { display: flex; gap: 2rem; list-style: none; }
    .nav-links a { font-size: .68rem; letter-spacing: .13em; text-transform: uppercase; text-decoration: none; color: var(--black); position: relative; cursor: none; }
    .nav-links a::after { content: ''; position: absolute; bottom: -2px; left: 0; width: 0; height: 2px; background: var(--pink); transition: width .2s ease; }
    .nav-links a:hover::after { width: 100%; }

    /* ══ LACE TOP BORDER ══ */
    .lace-top {
      position: absolute;
      top: 0; left: 0; right: 0;
      width: 100%;
      height: 60px;
      pointer-events: none;
      z-index: 3;
      opacity: 0.12;
    }

    /* ══ HERO ══ */
    .hero {
      min-height: 100vh;
      display: grid; grid-template-rows: auto 1fr;
      border-bottom: 4px solid var(--black);
      position: relative; overflow: hidden;
    }
    .hero-top {
      display: flex; justify-content: space-between; align-items: flex-start;
      padding: 5rem 2.5rem 0; position: relative; z-index: 2;
    }
    .hero-badge {
      background: var(--pink); color: var(--cream);
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1.1rem; letter-spacing: .1em;
      padding: 6px 16px; border: 3px solid var(--black);
      transform: rotate(2deg); box-shadow: 4px 4px 0 var(--black);
      margin-left: 1rem;
    }
    .hero-date { font-size: .62rem; letter-spacing: .14em; text-transform: uppercase; opacity: .45; text-align: right; }
    .hero-main {
      position: relative; z-index: 2;
      display: flex;
      align-items: center; justify-content: flex-start; padding: 0 2.5rem 3rem; gap: 1rem;
    }
    .hero-title-block { position: relative; margin-left: 3rem;}
    .hero-title { font-family: 'Bebas Neue', sans-serif; font-size: clamp(5.5rem, 15vw, 14rem); line-height: .82; letter-spacing: -.01em; }
    .hero-title .l1 { display: block; color: var(--black); }
    .hero-title .l2 { display: block; color: transparent; -webkit-text-stroke: 3px var(--pink); }
    .hero-title .l3 { display: block; color: var(--pink); text-shadow: 6px 6px 0 var(--black); }
    .deco { position: absolute; pointer-events: none; }
    .deco.s1 { top: 0; right: -4rem; font-size: 3.5rem; color: var(--yellow); animation: spin 12s linear infinite; }
    .deco.s2 { bottom: 3rem; left: -2rem; font-size: 2rem; color: var(--pink); animation: spin 9s linear infinite reverse; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .hero-sub { font-family: 'Caveat', cursive; font-size: 1.6rem; background: var(--yellow); color: var(--black); border: 3px solid var(--black); padding: 5px 18px; display: inline-block; transform: rotate(-2deg); box-shadow: 4px 4px 0 var(--black); margin-top: 1.2rem; }
    .pills { display: flex; gap: .6rem; flex-wrap: wrap; margin-top: 1.8rem; }
    .pill { font-size: .62rem; letter-spacing: .12em; text-transform: uppercase; padding: 5px 14px; border-radius: 999px; }
    .pill-black { background: var(--black); color: var(--cream); }
    .pill-pink  { background: var(--pink);  color: var(--cream); }
    .pill-lilac { background: var(--lilac); color: var(--black); }
    .pill-out   { border: 2px solid var(--black); color: var(--black); }

    /* ID Card */
    .hero-card-wrap { margin: 0 auto; display: flex; flex-direction: column; align-items: flex-start; gap: 1.2rem; padding-bottom: .5rem; padding-left: 60px;}
    .id-card {
      background: var(--pink); border: 3px solid var(--black); border-radius: 16px;
      padding: 2rem 2.2rem; width: 550px; box-shadow: 8px 8px 0 var(--black);
      position: relative; animation: popIn .7s .2s cubic-bezier(.34,1.56,.64,1) both;
    }
    .id-card::before { content: ''; width: 25px; height: 25px; background: var(--black); border-radius: 50%; position: absolute; top: -10px; left: 50%; transform: translateX(-50%); }
    .id-label { font-size: .6rem; letter-spacing: .2em; text-transform: uppercase; opacity: .6; margin-bottom: 1rem; }
    .id-body { display: flex; gap: 1.2rem; align-items: flex-start; }
    .id-img { width: 100px; height: 130px; background: var(--black); border: 3px solid var(--black); flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 2.8rem; color: var(--cream); }
    .id-info { flex: 1; }
    .id-name { font-family: 'Bebas Neue', sans-serif; font-size: 2rem; line-height: .92; color: var(--cream); text-shadow: 3px 3px 0 var(--black); }
    .id-role { font-family: 'Caveat', cursive; font-size: 1.1rem; color: var(--black); margin: .4rem 0 .7rem; }
    .id-desc { font-size: .7rem; line-height: 1.65; color: var(--black); }
    .id-sign { font-family: 'Caveat', cursive; font-size: 1.7rem; color: var(--cream); text-align: right; margin-top: .9rem; border-top: 2px solid rgba(0,0,0,.3); padding-top: .5rem; }
    .id-bar { font-size: .38rem; opacity: .45; margin-top: .3rem; text-align: center; word-break: break-all; }

    .ctas { display: flex; gap: .8rem; flex-direction: row; width: 500px; }
    .btn { display: flex; font-family: 'Bebas Neue', sans-serif; font-size: 1.4rem; letter-spacing: .06em; text-align: center; text-decoration: none; padding: .85rem 1.5rem; border: 3px solid var(--black); cursor: none; position: relative; overflow: hidden; transition: transform .15s ease, box-shadow .15s ease; }
    .btn-inner { position: relative; z-index: 1; }
    .btn::before { content: ''; position: absolute; inset: 0; transform: translateY(101%); transition: transform .25s cubic-bezier(.16,1,.3,1); }
    .btn:hover { transform: translate(-3px,-3px); }
    .btn-pink { background: var(--pink); color: var(--cream); box-shadow: 5px 5px 0 var(--black); }
    .btn-pink::before { background: var(--black); }
    .btn-pink:hover { box-shadow: 8px 8px 0 var(--black); color: var(--pink); }
    .btn-pink:hover::before { transform: translateY(0); }
    .btn-yellow { background: var(--yellow); color: var(--black); box-shadow: 5px 5px 0 var(--black); }
    .btn-yellow::before { background: var(--black); }
    .btn-yellow:hover { box-shadow: 8px 8px 0 var(--black); color: var(--yellow); }
    .btn-yellow:hover::before { transform: translateY(0); }

    /* STATEMENT */
    .statement { background: var(--pink); border-bottom: 4px solid var(--black); padding: 3.5rem 2.5rem; display: flex; align-items: center; gap: 4rem; overflow: hidden; position: relative; }
    .statement::before { content: '★'; font-size: 20rem; position: absolute; right: -2rem; top: -4rem; opacity: .07; color: var(--black); line-height: 1; pointer-events: none; }
    .stmt-big { font-family: 'Bebas Neue', sans-serif; font-size: clamp(4rem, 8vw, 8rem); line-height: .85; color: var(--cream); text-shadow: 4px 4px 0 var(--black); flex-shrink: 0; }
    .stmt-big .out { display: block; color: transparent; -webkit-text-stroke: 3px var(--cream); text-shadow: none; }
    .stmt-right { max-width: 530px; }
    .stmt-quote { font-family: 'Caveat', cursive; font-size: 1.85rem; color: var(--black); line-height: 1.35; margin-bottom: 1rem; }
    .stmt-body { font-size: .73rem; line-height: 1.78; color: var(--black); opacity: .85; }

    .tools-strip { background: var(--yellow); border-bottom: 4px solid var(--black); overflow: hidden; }
    .tools-track { display: inline-flex; animation: tick 18s linear infinite; padding: 1rem 0; }
    .tool { font-family: 'Bebas Neue', sans-serif; font-size: 1.5rem; letter-spacing: .06em; margin: 0 2rem; color: var(--black); display: flex; align-items: center; gap: .7rem; }
    .tool::after { content: '✦'; color: var(--pink); }

    #skills { padding: 5rem 2.5rem; border-bottom: 4px solid var(--black); position: relative; overflow: hidden; }
    #skills::before { content: 'SKILLS'; position: absolute; font-family: 'Bebas Neue', sans-serif; font-size: clamp(8rem, 20vw, 18rem); color: transparent; -webkit-text-stroke: 2px rgba(0,0,0,.045); top: 50%; left: 50%; transform: translate(-50%,-50%); pointer-events: none; white-space: nowrap; }
    .sec-hd { display: flex; align-items: baseline; gap: 1.5rem; margin-bottom: 3.5rem; }
    .sec-num { font-size: .68rem; letter-spacing: .18em; color: var(--pink); text-transform: uppercase; }
    .sec-title { font-family: 'Bebas Neue', sans-serif; font-size: clamp(3.5rem, 8vw, 7rem); line-height: .85; display: block; margin-bottom: 3.5rem; }
    .sec-title .out { color: transparent; -webkit-text-stroke: 3px var(--black); }
    .skills-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 0; border: 3px solid var(--black); }
    .sk { padding: 2.2rem 2rem; border: 1px solid var(--black); position: relative; overflow: hidden; transition: transform .2s ease, box-shadow .2s ease; }
    .sk:hover { z-index: 2; transform: scale(1.025); box-shadow: 0 0 0 3px var(--black); }
    .sk:nth-child(1){background:var(--black);color:var(--cream)} .sk:nth-child(2){background:var(--pink)} .sk:nth-child(3){background:var(--cream)} .sk:nth-child(4){background:var(--yellow)} .sk:nth-child(5){background:var(--lilac)} .sk:nth-child(6){background:var(--hot);color:var(--cream)}
    .sk-num { font-size: .6rem; letter-spacing: .2em; opacity: .4; margin-bottom: .6rem; }
    .sk-name { font-family: 'Bebas Neue', sans-serif; font-size: 2.7rem; line-height: .9; margin-bottom: .8rem; }
    .sk-desc { font-size: .7rem; line-height: 1.65; opacity: .8; }
    .sk-dots { display: flex; gap: 5px; margin-top: 1.2rem; }
    .dot { width: 9px; height: 9px; border-radius: 50%; border: 2px solid currentColor; }
    .dot.on { background: currentColor; }

    #creations { background: var(--black); padding: 5rem 2.5rem; border-bottom: 4px solid var(--pink); }
    #creations .sec-title { color: var(--cream); }
    #creations .sec-title .out { -webkit-text-stroke: 3px var(--cream); }
    #creations .sec-num { color: var(--yellow); }
    .gallery { display: grid; grid-template-columns: repeat(3,1fr); grid-auto-rows: 260px; gap: 3px; margin-top: 3rem; }
    .gi { position: relative; overflow: hidden; border: 2px solid rgba(255,245,225,.1); cursor: none; }
    .gi.tall { grid-row: span 2; } .gi.wide { grid-column: span 2; }
    .gi-bg { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 5rem; transition: transform .5s ease; }
    .gi:hover .gi-bg { transform: scale(1.08); }
    .gi-over { position: absolute; inset: 0; background: var(--pink); display: flex; flex-direction: column; justify-content: flex-end; padding: 1.5rem; opacity: 0; transition: opacity .3s ease; }
    .gi:hover .gi-over { opacity: 1; }
    .gi-title { font-family: 'Bebas Neue', sans-serif; font-size: 2.5rem; line-height: .9; color: var(--cream); text-shadow: 3px 3px 0 var(--black); }
    .gi-tag { font-size: .6rem; letter-spacing: .15em; text-transform: uppercase; color: var(--black); margin-top: .4rem; }
    .c1{background:#1e0a14}.c2{background:#0d1a0d}.c3{background:#1a1a0a}.c4{background:#0a0a1a}.c5{background:#1a0a0a}.c6{background:#0a1a1a}.c7{background:#140a1e}

    /* ── GALLERY ITEM CLICKABLE ── */
    .gi { cursor: none; }
    .gi-click-hint {
      position: absolute; bottom: 1.5rem; right: 1.5rem;
      background: var(--yellow); color: var(--black);
      font-family: 'Bebas Neue', sans-serif; font-size: .8rem; letter-spacing: .1em;
      padding: 4px 10px; border: 2px solid var(--black);
      opacity: 0; transform: translateY(6px);
      transition: opacity .3s ease, transform .3s ease;
      z-index: 2;
    }
    .gi:hover .gi-click-hint { opacity: 1; transform: translateY(0); }

    .contact-grid { display: grid; grid-template-columns: 1fr 1fr; }
    .contact-left { background: var(--yellow); padding: 5rem 3rem; border-right: 4px solid var(--black); position: relative; overflow: hidden; }
    .contact-left::after { content: '?'; font-family: 'Bebas Neue', sans-serif; font-size: 20rem; position: absolute; bottom: -2rem; right: 1rem; color: transparent; -webkit-text-stroke: 3px rgba(0,0,0,.07); pointer-events: none; line-height: 1; }
    .contact-big { font-family: 'Bebas Neue', sans-serif; font-size: clamp(3.5rem, 7vw, 7rem); line-height: .82; color: var(--black); position: relative; z-index: 1; }
    .contact-big .out { display: block; color: transparent; -webkit-text-stroke: 3px var(--black); }
    .contact-sub { font-family: 'Caveat', cursive; font-size: 1.4rem; margin-top: 1.5rem; color: var(--black); position: relative; z-index: 1; }
    .contact-right { background: var(--cream); padding: 5rem 3rem; display: flex; flex-direction: column; justify-content: center; gap: 1.2rem; }
    .cl { display: flex; align-items: center; gap: 1rem; text-decoration: none; color: var(--black); font-size: .73rem; letter-spacing: .05em; border-bottom: 2px solid var(--black); padding-bottom: .8rem; transition: color .2s, padding-left .2s; cursor: none; }
    .cl:hover { color: var(--pink); padding-left: 12px; }
    .cl-icon { width: 36px; height: 60px; background: var(--black); color: var(--cream); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: .85rem; flex-shrink: 0; transition: background .2s; font-family: 'Bebas Neue', sans-serif; }
    .cl:hover .cl-icon { background: var(--pink); }
    .email-strip { background: var(--black); overflow: hidden; border-top: 4px solid var(--pink); white-space: nowrap; }
    .email-track { display: inline-flex; animation: tick 14s linear infinite; padding: 1.5rem 0; }
    .email-track span { font-family: 'Bebas Neue', sans-serif; font-size: clamp(2rem,5vw,4rem); color: var(--cream); margin: 0 2rem; }
    .email-track .pk { color: var(--pink); }
    footer { background: var(--black); color: rgba(255,245,225,.3); font-size: .62rem; letter-spacing: .1em; display: flex; justify-content: space-between; align-items: center; padding: 1.2rem 2.5rem; border-top: 2px solid rgba(255,61,139,.25); }
    footer em { color: var(--pink); font-style: normal; }
    .reveal { opacity: 0; transform: translateY(28px); transition: opacity .65s ease, transform .65s ease; }
    .reveal.on { opacity: 1; transform: none; }
    @keyframes popIn { from { opacity:0;transform:scale(.88); } to { opacity:1;transform:scale(1); } }

    @media (max-width: 900px) {
      .hero-main { grid-template-columns: 1fr; }
      .id-card,.ctas { width: 100%; max-width: 430px; }
      .statement { flex-direction: column; gap: 2rem; }
      .skills-grid { grid-template-columns: 1fr 1fr; }
      .gallery { grid-template-columns: 1fr 1fr; }
      .gi.wide { grid-column: span 1; }
      .contact-grid { grid-template-columns: 1fr; }
      .contact-left { border-right: none; border-bottom: 4px solid var(--black); }
    }
    @media (max-width: 580px) {
      .skills-grid { grid-template-columns: 1fr; }
      .gallery { grid-template-columns: 1fr; }
      nav { padding: 1rem 1.2rem; }
      .nav-links { gap: .8rem; }
    }

    /* ════════════════════════════════════════
       DETAIL PAGES
    ════════════════════════════════════════ */
    .page-main { display: none; }
    .page-main.active { display: block; }
    #home-page { display: block; }
    #home-page.hidden { display: none; }

    /* Detail page nav */
    .detail-nav {
      display: flex; justify-content: space-between; align-items: center;
      padding: 1.1rem 2.5rem;
      border-bottom: 3px solid var(--black);
      background: var(--cream);
      position: sticky; top: 0; z-index: 99;
    }
    .back-btn {
      display: flex; align-items: center; gap: .6rem;
      font-family: 'Bebas Neue', sans-serif; font-size: 1.2rem; letter-spacing: .06em;
      text-decoration: none; color: var(--black); cursor: none;
      background: none; border: none; padding: 0;
      transition: color .2s ease;
    }
    .back-btn:hover { color: var(--pink); }
    .back-arrow { font-size: 1.4rem; }
    .detail-category-label {
      font-size: .62rem; letter-spacing: .18em; text-transform: uppercase;
      color: var(--pink); font-family: 'Space Mono', monospace;
    }

    /* Detail page hero banner */
    .detail-hero {
      background: var(--black); color: var(--cream);
      padding: 4rem 2.5rem 3rem;
      border-bottom: 4px solid var(--pink);
      position: relative; overflow: hidden;
    }
    .detail-hero::before {
      content: attr(data-emoji);
      position: absolute; right: 3rem; top: 50%; transform: translateY(-50%);
      font-size: 12rem; opacity: .08; pointer-events: none;
      line-height: 1;
    }
    .detail-hero-kicker {
      font-size: .62rem; letter-spacing: .2em; text-transform: uppercase;
      color: var(--yellow); margin-bottom: 1rem;
    }
    .detail-hero-title {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(3.5rem, 8vw, 8rem);
      line-height: .85; color: var(--cream);
      text-shadow: 4px 4px 0 var(--pink);
      position: relative; z-index: 1;
    }
    .detail-hero-tags {
      display: flex; gap: .5rem; flex-wrap: wrap; margin-top: 1.2rem;
      position: relative; z-index: 1;
    }
    .detail-projet-tags {
      display: flex; gap: .5rem; flex-wrap: wrap; 
      position: relative; z-index: 1; color: var(--black);
    }

    .detail-tag {
      font-size: .58rem; letter-spacing: .14em; text-transform: uppercase;
      padding: 4px 12px; border: 2px solid rgba(255,245,225,.3);
      color: rgba(255,245,225,.7); border-radius: 999px;
    }
    .detail-tag-noir {
      font-size: .58rem; letter-spacing: .14em; text-transform: uppercase;
      padding: 4px 12px; border: 2px solid rgb(0, 0, 0);
      color: var(--black); border-radius: 999px;
    }

    /* ── Layout A: image gauche / texte droite ── */
    .detail-layout-a {
      display: grid; grid-template-columns: 1fr 1fr;
      min-height: 65vh;
      border-bottom: 4px solid var(--black);
    }
    .detail-layout-a .img-side {
      background: var(--lilac); border-right: 4px solid var(--black);
      display: flex; align-items: center; justify-content: center;
      flex-direction: column; gap: 1rem; padding: 3rem;
      position: relative; overflow: hidden;
    }
    .detail-layout-a .text-side {
      padding: 4rem 3rem;
      display: flex; flex-direction: column; justify-content: center;
    }

    /* ── Layout B: texte gauche / image droite ── */
    .detail-layout-b {
      display: grid; grid-template-columns: 1fr 1fr;
      min-height: 65vh;
      border-bottom: 4px solid var(--black);
    }
    .detail-layout-b .text-side {
      padding: 4rem 3rem; background-color: #d4c7d5;
      display: flex; flex-direction: column; justify-content: center;
      border-right: 4px solid var(--black);
    }
    .detail-layout-b .img-side {
      background: var(--black);
      display: flex; align-items: center; justify-content: center;
      flex-direction: column; gap: 1rem; padding: 3rem;
      position: relative; overflow: hidden;
    }

    /* ── Layout C: grande image haut / texte bas ── */
    .detail-layout-c .img-top {
      background: var(--pink);
      min-height: 55vh;
      display: flex; align-items: center; justify-content: center;
      flex-direction: column; gap: 1.5rem; padding: 3rem;
      border-bottom: 4px solid var(--black);
      position: relative; overflow: hidden;
    }
    .detail-layout-c .text-bottom {
      padding: 4rem 3rem;
      display: grid; grid-template-columns: 1fr 1fr; gap: 3rem;
      border-bottom: 4px solid var(--black);
    }

    /* ── Layout D: pleine largeur asymétrique ── */
    .detail-layout-d {
      display: grid; grid-template-columns: 1.9fr 1.1fr;
      min-height: 65vh;
      border-bottom: 4px solid var(--black);
    }
    .detail-layout-d .img-side {
      background: var(--black); border-right: 4px solid var(--black);
      display: flex; align-items: center; justify-content: center;
      flex-direction: column; gap: 1rem; padding: 3rem;
      position: relative; overflow: hidden;
    }
    .detail-layout-d .text-side {
      padding: 4rem 3rem; background: var(--hot); color: var(--cream);
      display: flex; flex-direction: column; justify-content: center;
    }

    /* ── Layout E: texte centré + image droite étroite ── */
    .detail-layout-e {
      display: grid; grid-template-columns: 3fr 2fr;
      min-height: 65vh;
      border-bottom: 4px solid var(--black);
    }
    .detail-layout-e .text-side {
      padding: 4rem 3rem; background: var(--cream);
      display: flex; flex-direction: column; justify-content: center;
      border-right: 4px solid var(--black);
    }
    .detail-layout-e .img-side {
      background: var(--lilac);
      display: flex; align-items: center; justify-content: center;
      flex-direction: column; gap: 1rem; padding: 3rem;
      position: relative; overflow: hidden;
    }

    /* ── Layout F: image gauche large ── */
    .detail-layout-f {
      display: grid; grid-template-columns: 3fr 2fr;
      min-height: 65vh;
      border-bottom: 4px solid var(--black);
    }
    .detail-layout-f .img-side {
      background: var(--yellow); border-right: 4px solid var(--black);
      display: flex; align-items: center; justify-content: center;
      flex-direction: column; gap: 1rem; padding: 3rem;
      position: relative; overflow: hidden;
    }
    .detail-layout-f .text-side {
      padding: 4rem 3rem; background: var(--black); color: var(--cream);
      display: flex; flex-direction: column; justify-content: center;
    }

    /* ── Layout G: mosaïque 3 colonnes ── */
    .detail-layout-g {
      border-bottom: 4px solid var(--black);
    }
    .detail-layout-g .mosaic-top {
      display: grid; grid-template-columns: 1fr 1fr;
      min-height: 50vh;
    }
    .detail-layout-g .img-main {
      background: var(--lilac); border-right: 4px solid var(--black); border-bottom: 4px solid var(--black);
      display: flex; align-items: center; justify-content: center;
      padding: 3rem; position: relative; overflow: hidden;
    }
    .detail-layout-g .img-secondary {
      background: var(--pink); border-bottom: 4px solid var(--black);
      display: flex; align-items: center; justify-content: center;
      padding: 3rem; position: relative; overflow: hidden;
    }
    .detail-layout-g .text-bottom-g {
      padding: 3.5rem 3rem;
      display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem;
    }

    /* Shared image placeholder */
    .img-placeholder {
      width: 100%; aspect-ratio: 4/3; max-width: 500px;
      background: rgba(0,0,0,.08); border: 3px dashed rgba(0,0,0,.2);
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      gap: .8rem; border-radius: 4px;
    }
    .detail-layout-g .img-placeholder {
      max-width: none;
      aspect-ratio: auto;
      background: none;
      border: none;
    }
    .detail-layout-g .img-main img,
    .detail-layout-g .img-secondary img {
      width: 100%;
      max-width: none;
      height: auto;
      display: block;
      object-fit: cover;
    }
    .img-placeholder-dark {
      background: rgba(255,255,255,.06); border-color: rgba(255,255,255,.2);
    }
    .img-placeholder-icon { font-size: 3rem; opacity: .4; }
    .img-placeholder-label {
      font-size: .6rem; letter-spacing: .15em; text-transform: uppercase;
      opacity: .45; text-align: center;
    }
    .img-placeholder-label-dark { color: rgba(255,255,255,.5); }

    /* Detail text elements */
    .detail-section-label {
      font-size: .58rem; letter-spacing: .2em; text-transform: uppercase;
      color: var(--pink); margin-bottom: 1rem;
    }
    .detail-section-label-light { color: var(--yellow); }
    .detail-h2 {
      font-family: 'Bebas Neue', sans-serif; font-size: clamp(2.2rem, 4vw, 3.5rem);
      line-height: .88; margin-bottom: 1.2rem; color: var(--black);
    }
    .detail-h2-light { color: var(--cream); }
    .detail-body {
      font-size: .73rem; line-height: 1.78; opacity: .8;
    }
    .detail-body p + p { margin-top: .9rem; }
    .detail-highlight {
      font-family: 'Caveat', cursive; font-size: 1.5rem;
      background: var(--yellow); color: var(--black);
      border: 3px solid var(--black); padding: 4px 14px;
      display: inline-flex; align-items: center; width: max-content; max-width: 100%; white-space: nowrap;
      transform: rotate(-1deg);
      box-shadow: 3px 3px 0 var(--black); margin: 1rem 0;
    }

    /* Second content block (extra images row) */
    .detail-extras {
      padding: 3rem 2.5rem;
      border-bottom: 4px solid var(--black);
      background: var(--cream);
    }
    .detail-extras-title {
      font-family: 'Bebas Neue', sans-serif; font-size: 1.8rem; letter-spacing: .04em;
      margin-bottom: 1.5rem; color: var(--black);
    }
    .detail-extras-grid {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem;
    }
    .detail-extra-item {
      background: #ffde59; border: 3px solid var(--black); border-radius: 2px;
      aspect-ratio: 1; display: flex; align-items: center; justify-content: center;
      flex-direction: column; gap: .5rem; overflow: hidden; position: relative;
    }
    .extra-item img {
      margin: 0;
      padding: 2rem;
      align-items: center;
    }
    .detail-extra-item img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
    .detail-extra-item:nth-child(2) { background: #ffde59; }
    .detail-extra-item:nth-child(3) { background: #ffde59; }

    @media (max-width: 900px) {
      .detail-layout-a, .detail-layout-b, .detail-layout-d,
      .detail-layout-e, .detail-layout-f { grid-template-columns: 1fr; }
      .detail-layout-a .img-side, .detail-layout-b .text-side,
      .detail-layout-d .img-side, .detail-layout-e .text-side,
      .detail-layout-f .img-side {
        border-right: none; border-bottom: 4px solid var(--black);
        min-height: 40vh;
      }
      .detail-layout-c .text-bottom { grid-template-columns: 1fr; }
      .detail-layout-g .mosaic-top { grid-template-columns: 1fr; }
      .detail-layout-g .img-main { border-right: none; }
      .detail-layout-g .text-bottom-g { grid-template-columns: 1fr; }
      .detail-extras-grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 580px) {
      .detail-extras-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
