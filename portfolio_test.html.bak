<!-- Bloc intro : image identity gauche / texte description droite -->
  <div class="detail-layout-a">
    <div class="img-side" style="background:#1a1a1a; padding:0; overflow:hidden;">
        <div style="font-size:.58rem; letter-spacing:.18em; text-transform:uppercase; color:var(--yellow); margin-bottom:1rem;">Charte graphique</div>
