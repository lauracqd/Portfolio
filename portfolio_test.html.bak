    </div>
  </div>
  <div class="detail-layout-b" style="grid-template-columns:1fr 1fr; gap:0;">
    <div class="detail-extras" style="background:var(--black); color:var(--cream); padding:2.5rem; align-self:stretch; display:flex; justify-content:center; align-items:center;">
      <div style="display:flex; gap:0; flex-wrap:wrap; justify-content:center; width:100%;">
