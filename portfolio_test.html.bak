<!-- ═══════════════════════════════════════
     SCRIPTS
═══════════════════════════════════════ -->
<script>
  // ── STAR CURSOR ───────────────────────────────────────────
  const cur  = document.getElementById('cur');
  const path = cur.querySelector('path');

  document.addEventListener('mousemove', e => {
    cur.style.left = e.clientX + 'px';
    cur.style.top  = e.clientY + 'px';
  });

  document.querySelectorAll('a, button, .sk, .gi, .btn, .back-btn').forEach(el => {
    el.addEventListener('mouseenter', () => {
      cur.classList.add('big');
      path.setAttribute('fill',   '#FFE24B');
      path.setAttribute('stroke', '#FFE24B');
    });
    el.addEventListener('mouseleave', () => {
      cur.classList.remove('big');
      path.setAttribute('fill',   '#FF3D8B');
      path.setAttribute('stroke', '#FF3D8B');
    });
  });

  // ── SCROLL REVEAL ─────────────────────────────────────────
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('on'); obs.unobserve(e.target); }
    });
  }, { threshold: .12 });

  document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

  document.querySelectorAll('.sk').forEach((el, i) => {
    el.classList.add('reveal');
    el.style.transitionDelay = (i * .08) + 's';
    obs.observe(el);
  });

  document.querySelectorAll('.gi').forEach((el, i) => {
    el.classList.add('reveal');
    el.style.transitionDelay = (i * .06) + 's';
    obs.observe(el);
  });

  // ── PAGE NAVIGATION ───────────────────────────────────────
  const homePage = document.getElementById('home-page');
  const allPages = document.querySelectorAll('.page-main');

  // Pages data for nav label
  const pageLabels = {
    c1: 'Brand Identity',
    c2: 'Editorial',
    c3: 'Print',
    c4: 'Réseaux Sociaux',
    c5: 'UI / UX & Maquettes',
    c6: 'Audiovisuel',
    c7: 'OSINT',
  };

  function showPage(id) {
    // Hide home
    homePage.classList.add('hidden');

    // Hide all detail pages
    allPages.forEach(p => p.style.display = 'none');

    // Show target
    const target = document.getElementById('page-' + id);
    if (target) {
      target.style.display = 'block';

      // Inject or update the detail nav inside the page
      let detailNav = target.querySelector('.detail-nav');
      if (!detailNav) {
        detailNav = document.createElement('div');
        detailNav.className = 'detail-nav';
        detailNav.innerHTML = `
          <button class="back-btn" onclick="showHome('creations')">
            <span class="back-arrow">←</span> Retour aux créations
          </button>
          <span class="detail-category-label">${pageLabels[id] || ''}</span>
        `;
        target.insertBefore(detailNav, target.firstChild);

        // Re-attach cursor effects for new buttons
        detailNav.querySelectorAll('button, a').forEach(el => {
          el.addEventListener('mouseenter', () => {
            cur.classList.add('big');
            path.setAttribute('fill', '#FFE24B');
            path.setAttribute('stroke', '#FFE24B');
          });
          el.addEventListener('mouseleave', () => {
            cur.classList.remove('big');
            path.setAttribute('fill', '#FF3D8B');
            path.setAttribute('stroke', '#FF3D8B');
          });
        });
      }
    }

    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function showHome(anchor) {
    // Hide all detail pages
    allPages.forEach(p => p.style.display = 'none');

    // Show home
    homePage.classList.remove('hidden');

    // Scroll to anchor if provided
    if (anchor) {
      setTimeout(() => {
        const target = document.getElementById(anchor);
        if (target) target.scrollIntoView({ behavior: 'smooth' });
      }, 50);
    } else {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  }
</script>
</body>
</html>
